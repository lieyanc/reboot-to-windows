// Let local, active admin sessions start reboot-to-windows.service without a
// password. Only the "start" verb on this one unit is allowed.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "reboot-to-windows.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
